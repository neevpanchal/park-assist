# ==========================================================
# SMART UNIVERSITY PARKING MANAGEMENT SYSTEM - ENVIRONMENT CONFIG
# ==========================================================

# Secret key for Flask session signing
SECRET_KEY=smart_parking_secure_secret_key_2026

# Application Port (default 5000)
PORT=5000

# ----------------------------------------------------------
# SMTP EMAIL CONFIGURATION (For Registration OTP & Alerts)
# ----------------------------------------------------------
# If left blank or unconfigured, the system runs in Demo Mode:
# OTPs will be displayed in server logs and on-screen demo banners.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your_university_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_SENDER="Campus Smart Parking <noreply@university.edu>"

# ----------------------------------------------------------
# AI ANALYTICS API (Optional - Google Gemini API)
# ----------------------------------------------------------
# If provided, the Admin AI Analytics uses Gemini for live insights.
# If omitted, the system seamlessly uses the built-in SQLite data-driven
# heuristic analytics engine (no API key required).
GEMINI_API_KEY=
